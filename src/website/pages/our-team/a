            <motion.p
                className="text-sm lg:text-base text-gray-700 mt-1"
                initial={{ opacity: 0, y: 10 }}
                whileInView={{ opacity: 1, y: 0 }}
                viewport={{ once: true }}
                transition={{ delay: 0.2, duration: 0.3 }}
            >
                {member.position}
            </motion.p>
