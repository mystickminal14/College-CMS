RewriteOptions inherit
RewriteEngine On

# Redirect non-www to www
RewriteCond %{HTTP_HOST} ^lbef\.org$ [NC]
RewriteRule ^ https://www.lbef.org%{REQUEST_URI} [R=301,L]

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# PHP routes
RewriteRule ^ourteam$ ourteam.php [L]
RewriteRule ^our-team$ ourteam.php [L]
RewriteRule ^about$ about.php [L]
RewriteRule ^aboutus$ about.php [L]
RewriteRule ^about-us$ about.php [L]
RewriteRule ^recognitions$ recognitions.php [L]
RewriteRule ^messages$ messages.php [L]
RewriteRule ^achivements$ achivements.php [L]
RewriteRule ^infrastructure$ infrastructure.php [L]
RewriteRule ^training-placement-cell$ training-placement-cell.php [L]
RewriteRule ^administrative-holidays$ administrative-holidays.php [L]
RewriteRule ^intake-calendar$ intake-calendar.php [L]

# Blog detail pages -> PHP SEO injector (injects per-blog meta tags for crawlers).
# Requires a slug segment, so /blogs (list) falls through to the SPA below.
RewriteRule ^blogs/([A-Za-z0-9._-]+)/?$ blog-seo.php?slug=$1 [L,QSA]

# PHP handler
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>

# Exclude API and upload/static directories
RewriteCond %{REQUEST_URI} !^/api
RewriteCond %{REQUEST_URI} !^/uploads
RewriteCond %{REQUEST_URI} !^/images
RewriteCond %{REQUEST_URI} !^/public
RewriteCond %{REQUEST_URI} !^/ugc

# Exclude ALL static file extensions
RewriteCond %{REQUEST_URI} !\.(jpg|jpeg|png|gif|webp|svg|ico|css|js|pdf|doc|docx|xls|xlsx|ppt|pptx|zip|rar|mp4|mp3|woff|woff2|ttf|eot)$ [NC]

# Don't touch real files/folders
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# React SPA fallback
RewriteRule ^ index.html [L]

# Font MIME types
<IfModule mime_module>
  AddType font/woff          .woff
  AddType font/woff2         .woff2
  AddType font/ttf           .ttf
  AddType font/otf           .otf
  AddType application/vnd.ms-fontobject .eot
</IfModule>

# CORS for fonts (required when fonts load cross-origin or via CDN)
<IfModule mod_headers.c>
  <FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# Cache fonts for 1 year (they are content-hashed so safe to cache forever)
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
    ExpiresDefault "access plus 1 year"
    Header append Cache-Control "public, immutable"
  </FilesMatch>
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php83" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
